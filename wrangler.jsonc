// Carreadi Worker configuration (Wrangler).
//
// Custom domains and secrets are managed in the Cloudflare dashboard and are deliberately NOT
// listed here: Wrangler deploys leave dashboard custom domains and secrets in place.
// (Earlier this project used cloudflare.config.ts, whose deploys enforce the file exactly:
// they removed undeclared secrets and refused to deploy around dashboard domains.)
//
// Secrets the app reads (set in dashboard → Settings → Variables and Secrets, type Secret):
//   QUOTA_SALT, ADMIN_TOKEN, BACHS_API_KEY, BACHS_WEBHOOK_SECRET, BACHS_ORGANIZATION_ID,
//   optional POSTHOG_KEY / POSTHOG_HOST. Local dev reads them from .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carreadi",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  // Workers AI always runs on Cloudflare, also during local dev (needs `npx wrangler login`).
  "ai": { "binding": "AI", "remote": true },
  // Usage counters, payments, requests. No résumé data is stored.
  "d1_databases": [{ "binding": "DB", "database_name": "carreadi-db", "database_id": "36ed9169-20d2-4c01-910b-c22c441430ee" }],
  // Shared job-board cache (public job data only).
  "kv_namespaces": [{ "binding": "JOBS_KV", "id": "f59e6ba9a45141f4902fb22f48775b8d" }],
  // Burst limiter for every API route, per network address. Roomy enough for a whole room on one
  // Wi-Fi (career day); costly actions have their own daily caps. Keep in step with BURST_LIMIT in lib/server/guard.ts.
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }]
}
